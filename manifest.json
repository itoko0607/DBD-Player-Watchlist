{
  "manifest_version": 3,
  "name": "DBD Player Watchlist",
  "version": "0.4.11",
  "description": "Steamプロフィール上でDBDプレイヤーの記録・お気に入り・バックアップを管理します。",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://steamcommunity.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
